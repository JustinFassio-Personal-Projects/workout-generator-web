---
// Hero component - Pure Astro (static HTML, no JS)
// Direct auth: send users to app with auth modal open (no onboarding redirect)
const appBase = (import.meta.env.PUBLIC_APP_URL || 'https://app.aiworkoutgenerator.com').replace(/\/$/, '');
const directAuthUrl = `${appBase}?signin=1`;
---

<section id="hero" class="hero-section relative min-h-screen flex flex-col justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="hero-bg">
    <img
      src="/ai_workout_generator_hero_1.png"
      alt="AI-powered workout generator showing personalized fitness plan interface"
      class="w-full h-full object-cover object-center"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-dark)] via-[var(--bg-dark)]/80 to-[var(--bg-dark)]/40"></div>
  </div>

  <!-- Logo watermark (decorative) -->
  <div class="hero-watermark" aria-hidden="true">
    <img src="/logo.png" alt="" width="400" height="400" loading="lazy" decoding="async" />
  </div>
  
  <!-- Content -->
  <div class="hero-content">
    <div class="hero-content-inner container-custom">
      <div class="max-w-4xl mx-auto text-center" data-aos="fade-up">
      <!-- Trust Badges -->
      <div class="flex flex-col items-center gap-3 mb-8">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--color-orange-light)]/10 border border-[var(--color-orange-light)]/20 text-[var(--color-orange-light)] text-sm font-medium">
          <span class="w-2 h-2 rounded-full bg-[var(--color-orange-light)] animate-pulse"></span>
          Vetted by U.S. Army Master Fitness Trainer.
        </div>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--color-orange-medium)]/10 border border-[var(--color-orange-medium)]/20 text-[var(--color-orange-medium)] text-sm font-medium">
          <span class="w-2 h-2 rounded-full bg-[var(--color-orange-medium)] animate-pulse"></span>
          100% Hallucination-Free.
        </div>
      </div>
      
      <!-- Headline -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight">
        Stop Guessing. <span class="text-white">Start Training.</span>
        <br />
        <span class="gradient-text">The Science-Based AI Workout Generator.</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-secondary max-w-2xl mx-auto mb-8">
        Instantly build personalized <strong class="text-primary">Hypertrophy & Strength</strong> cycles tailored to
        your equipment. Our <strong class="text-primary">Closed-Loop Engine</strong> eliminates algorithmic errors,
        ensuring every rep is biomechanically valid and safe.
      </p>
      
      <!-- CTAs: shared .cta-primary / .cta-secondary from design-system; primary = direct auth (app ?signin=1) -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a
          href={directAuthUrl}
          data-cta="hero-generate-workout"
          class="cta-primary"
        >
          Generate Workout
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </a>
        <a
          href="#journey"
          data-cta="hero-see-logic"
          class="cta-secondary"
        >
          See the Logic
        </a>
      </div>
      
      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-2xl mx-auto">
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-bold text-[var(--color-orange-light)]">8,000+</p>
          <p class="text-sm text-tertiary">Athletes Optimized</p>
        </div>
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-bold text-[var(--color-orange-light)]">15k+</p>
          <p class="text-sm text-tertiary">Plans Generated</p>
        </div>
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-bold text-[var(--color-orange-light)]">4.9/5</p>
          <p class="text-sm text-tertiary">TrustPilot Score</p>
        </div>
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-bold text-[var(--color-orange-light)]">Zero</p>
          <p class="text-sm text-tertiary">Hallucinations</p>
        </div>
      </div>
    </div>
    </div>
  </div>
  
  <!-- Feature Highlights Bar -->
  <div class="relative z-10 bg-[var(--glass-bg-base)] backdrop-blur-md border-t border-b border-[var(--glass-border-base)] py-6">
    <div class="container-custom">
      <div class="grid md:grid-cols-3 gap-6">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-orange-light)]/10 flex items-center justify-center text-[var(--color-orange-light)]">
            <!-- Lucide CheckCircle2 -->
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </div>
          <div>
            <p class="font-semibold">Anti-Hallucination Engine</p>
            <p class="text-sm text-tertiary">Biomechanically verified exercises only.</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-orange-medium)]/10 flex items-center justify-center text-[var(--color-orange-medium)]">
            <!-- Lucide Dumbbell (paths from lucide-react) -->
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.596 12.768a2 2 0 1 0 2.829-2.829l-1.768-1.767a2 2 0 0 0 2.828-2.829l-2.828-2.828a2 2 0 0 0-2.829 2.828l-1.767-1.768a2 2 0 1 0-2.829 2.829z" />
              <path d="m2.5 21.5 1.4-1.4" />
              <path d="m20.1 3.9 1.4-1.4" />
              <path d="M5.343 21.485a2 2 0 1 0 2.829-2.828l1.767 1.768a2 2 0 1 0 2.829-2.829l-6.364-6.364a2 2 0 1 0-2.829 2.829l1.768 1.767a2 2 0 0 0-2.828 2.829z" />
              <path d="m9.6 14.4 4.8-4.8" />
            </svg>
          </div>
          <div>
            <p class="font-semibold">Equipment Adaptive</p>
            <p class="text-sm text-tertiary">Dumbbells, Bodyweight, or Full Gym.</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-orange-dark)]/10 flex items-center justify-center text-[var(--color-orange-light)]">
            <!-- Lucide TrendingUp -->
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
              <polyline points="16 7 22 7 22 13" />
            </svg>
          </div>
          <div>
            <p class="font-semibold">Progressive Overload</p>
            <p class="text-sm text-tertiary">Smart volume scaling & periodization.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: linear-gradient(180deg, var(--bg-dark) 0%, var(--bg-gradient-end) 100%);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      linear-gradient(
        180deg,
        rgba(15, 23, 42, 0.85) 0%,
        rgba(15, 23, 42, 0.9) 50%,
        rgba(15, 23, 42, 0.95) 100%
      ),
      radial-gradient(circle at 0% 0%, rgba(255, 191, 0, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 100% 100%, rgba(255, 128, 0, 0.08) 0%, transparent 50%),
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size:
      100% 100%,
      100% 100%,
      100% 100%,
      40px 40px,
      40px 40px;
    pointer-events: none;
    z-index: 1;
  }

  .hero-section::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1000px;
    height: 600px;
    background: rgba(255, 191, 0, 0.08);
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    mix-blend-mode: screen;
    z-index: 0;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
  }

  .hero-watermark {
    position: absolute;
    bottom: 0;
    right: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.06;
    transform: rotate(-15deg);
  }

  .hero-watermark img {
    display: block;
    width: 400px;
    height: auto;
    max-width: 400px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--spacing-5xl) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--navbar-height));
  }

  @media (max-width: 968px) {
    .hero-content {
      padding: var(--spacing-4xl) var(--spacing-lg);
      min-height: auto;
    }
  }

  .hero-content-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
