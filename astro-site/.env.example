# Required for blog, leads, deep-research, and analytics (page-view + funnel events).
# Must match the same Supabase project that admin-dash-astro uses so production traffic appears.
# Get from Supabase Dashboard → Project Settings → API.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Optional: CORS origins for /api/analytics/track-event (hub sends account_signup_complete). Comma-separated. Default: https://app.aiworkoutgenerator.com, http://localhost:3000
# PUBLIC_ANALYTICS_CORS_ORIGIN=https://app.aiworkoutgenerator.com,http://localhost:3000

# Optional: canonicals, sitemap, OG. Defaults to https://aiworkoutgenerator.com if unset.
# PUBLIC_SITE_URL=https://aiworkoutgenerator.com

# App domain (signup/login redirects). Default: https://app.aiworkoutgenerator.com
# PUBLIC_APP_URL=https://app.aiworkoutgenerator.com

# Programs app root URL for Admin link in footer (e.g. https://programs.aiworkoutgenerator.com). When set, footer shows "Admin" under Support linking to {PUBLIC_PROGRAMS_ADMIN_URL}/admin. In local dev, if unset, the link still appears and points to http://localhost:3006/admin.
# PUBLIC_PROGRAMS_ADMIN_URL=https://programs.aiworkoutgenerator.com

# Stripe payment links (pricing section). Premium $11.99 default: https://buy.stripe.com/dRm6oHcW3gW19RZ6qlgnK00
# PUBLIC_STRIPE_PAYMENT_LINK_PREMIUM=
# PUBLIC_STRIPE_PAYMENT_LINK_PRO=
# PUBLIC_STRIPE_PAYMENT_LINK_ELITE=
# PUBLIC_STRIPE_PAYMENT_LINK_COACH=
# PUBLIC_STRIPE_PAYMENT_LINK_COACH_PRO=

# Optional: Analytics (BaseLayout.astro)
# PUBLIC_GA_ID=
# PUBLIC_GTM_ID=
# PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Turnstile: leads form (api/leads.ts). Server key required for submit.
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Turnstile: reports live demo (client) and api/reports/gemini-workout.ts (server)
# PUBLIC_TURNSTILE_REPORTS_SITE_KEY=
# TURNSTILE_REPORTS_SECRET_KEY=

# Optional: Gemini report API (api/reports/gemini-workout.ts)
# GEMINI_API_KEY=

# Optional: Statsig (if used in Astro)
# PUBLIC_STATSIG_CLIENT_KEY=
# STATSIG_SERVER_API_KEY=

# Optional: Support / ChatKit (if used in Astro)
# PUBLIC_CHATKIT_WORKFLOW_ID=
# FIREBASE_CLOUD_FUNCTION_URL=

# Server-only: do not expose to client. Use only in API routes or .astro server code.
# SUPABASE_SERVICE_ROLE_KEY=
