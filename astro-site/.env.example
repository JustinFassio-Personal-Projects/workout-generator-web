# Required for Phase 0 and blog/leads/deep-research:
# Supabase (for blog API, leads API, deep-research). Same project as .cursor/mcp.json (ref: qbklyimfazrkutwqictw).
# If unset, /api/blog returns [] and BlogPreview shows fallback posts.
# Get values from Supabase Dashboard → Project Settings → API (Project URL + anon public key).
PUBLIC_SUPABASE_URL=https://qbklyimfazrkutwqictw.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Optional: Canonicals, sitemap, OG, feed. Defaults to https://aiworkoutgenerator.com if unset.
# PUBLIC_SITE_URL=https://aiworkoutgenerator.com

# Optional: Analytics (BaseLayout.astro)
# PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# PUBLIC_GA_ID=
# PUBLIC_GTM_ID=

# Optional: Stripe payment link URLs for pricing CTAs.
# If unset, CTAs fall back to the login URL (https://aiworkoutgen.app/login).
# PUBLIC_STRIPE_PAYMENT_LINK_BASIC=
# PUBLIC_STRIPE_PAYMENT_LINK_PRO=
# PUBLIC_STRIPE_PAYMENT_LINK_ELITE=
# PUBLIC_STRIPE_PAYMENT_LINK_COACH=
# PUBLIC_STRIPE_PAYMENT_LINK_COACH_PRO=

# Optional: Reports live demo (client). Reports page shows message if unset.
# PUBLIC_TURNSTILE_REPORTS_SITE_KEY=

# Required to test lead form submit (api/leads.ts). Server-only; do not expose to client.
# TURNSTILE_SECRET_KEY=

# Optional: Gemini report API and Turnstile (api/reports/gemini-workout.ts). Server-only.
# TURNSTILE_REPORTS_SECRET_KEY=
# GEMINI_API_KEY=
