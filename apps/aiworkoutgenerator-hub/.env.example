# Firebase Configuration
# Copy this file to .env.local and fill in your actual Firebase project values.
# Get these values from: https://console.firebase.google.com/project/YOUR_PROJECT_ID/settings/general
#
# If you leave placeholder values, the app will not connect to Firebase (avoids
# "auth/network-request-failed" / "Could not reach Cloud Firestore backend"). For local
# dev without a real project, you can use the Firebase emulator — run `npm run firebase:emulators`
# and set NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 and
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 in .env.local.
#
# IMPORTANT — Using real Firebase (production): Do NOT set the emulator host variables.
# If NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST or NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST are set,
# the app will try to reach the emulator (e.g. 127.0.0.1:9099). If the emulator isn't running
# you'll get ERR_CONNECTION_REFUSED and "auth/network-request-failed". Remove or comment out
# those two variables in .env.local when using your real Firebase project.

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
# Production (Firebase App Hosting): secret firebase-auth-domain = app.aiworkoutgenerator.com (see apphosting.yaml + docs/FIREBASE_APP_HOSTING_ENV_VARS.md). Env wins over FIREBASE_WEBAPP_CONFIG authDomain.
# Local: your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Optional local/CI: web snippet JSON. Not in apphosting.yaml by default; NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN still wins when set.
# FIREBASE_WEBAPP_CONFIG={"apiKey":"...","authDomain":"app.aiworkoutgenerator.com",...}
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: For Google Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: Firebase App Check (bot protection for API routes)
# Enable in production to require valid App Check tokens on API requests.
# Client: set NEXT_PUBLIC_FIREBASE_APP_CHECK_ENABLED=true and register reCAPTCHA v3 in Firebase Console.
# Server: set FIREBASE_APP_CHECK_ENABLED=true to enforce verification.
# See docs/setup/FIREBASE_APP_CHECK.md
# NEXT_PUBLIC_FIREBASE_APP_CHECK_ENABLED=false
# FIREBASE_APP_CHECK_ENABLED=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# Optional: AI Rate Limiting Configuration
# Increase this value (in milliseconds) if you're hitting Gemini API rate limits frequently
# Default: 5000ms (5 seconds). Higher values = longer waits between retries but fewer rate limit errors
# GENKIT_RATE_LIMIT_RETRY_DELAY_MS=5000

# Optional: Marketing site URL for analytics (account_signup_complete). Default: https://aiworkoutgenerator.com. Used when hub sends signup event to site's /api/analytics/track-event.
# NEXT_PUBLIC_MARKETING_SITE_URL=https://aiworkoutgenerator.com

# Optional: Sentry Error Tracking
# Sentry is optional - the app works without it (graceful degradation)
# Get DSN from: Sentry > Project Settings > Client Keys (DSN)
# OpenTelemetry (OTLP) endpoint: Sentry > Project Settings > Client Keys (DSN) > OTLP
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXX.ingest.us.sentry.io/XXXX
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# For US region (ai-workout-generator): SENTRY_URL=https://us.sentry.io (required for source map uploads)
# SENTRY_URL=https://us.sentry.io
# Optional: set to true to enable the Sentry verification page in production (default: disabled)
# NEXT_PUBLIC_SENTRY_VERIFICATION_ENABLED=false
# Optional: set to true in dev to send events to Sentry Spotlight (npx @sentry/spotlight); otherwise Spotlight is disabled to avoid ERR_CONNECTION_REFUSED
# NEXT_PUBLIC_SENTRY_SPOTLIGHT=false
