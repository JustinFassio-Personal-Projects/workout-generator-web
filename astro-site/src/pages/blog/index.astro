---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/landing/Footer.astro';
import BlogHero from '@/components/blog/BlogHero.astro';
import { BlogIndexClient } from '@/components/react/BlogIndexClient/BlogIndexClient';
import { getAllPublishedPosts, toTransformedPost } from '@/lib/blog/queries';
import { buildBreadcrumbSchema } from '@/lib/breadcrumbSchema';

export const prerender = false;

const posts = await getAllPublishedPosts(Astro.cookies);
const transformedPosts = posts.map(toTransformedPost);

const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://aiworkoutgenerator.com';
const pageTitle = 'Blog | Fitness Tips & Workout Strategies';
const pageDescription =
  'Discover expert fitness tips, workout strategies, and AI-powered training advice to help you achieve your goals. Start your journey today!';

const breadcrumbSchema = buildBreadcrumbSchema(baseUrl, [
  { name: 'Home', url: baseUrl },
  { name: 'Blog', url: `${baseUrl}/blog` },
]);

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Workout Generator Blog',
  description: pageDescription,
  url: `${baseUrl}/blog`,
  publisher: {
    '@type': 'Organization',
    name: 'Workout Generator',
    logo: {
      '@type': 'ImageObject',
      url: `${baseUrl}/logo.png`,
    },
  },
  blogPost: transformedPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    url: `${baseUrl}/blog/${post.slug}`,
    datePublished: post.date,
    dateModified: post.dateModified,
    author: {
      '@type': 'Person',
      name: post.author,
    },
    articleSection: post.category,
    image: post.image
      ? post.image.startsWith('http')
        ? post.image
        : `${baseUrl}${post.image}`
      : `${baseUrl}/og-image.jpg`,
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${baseUrl}/blog`}
  ogImage={`${baseUrl}/og-image.jpg`}
  structuredData={[breadcrumbSchema, blogSchema]}
>
  <main class="min-h-screen">
    <BlogHero title="Fitness Tips & Workout Strategies" subtitle={pageDescription} />

    <section class="py-16 md:py-24">
      <div class="container-custom">
        <nav class="flex items-center gap-2 text-sm text-secondary mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <span class="text-primary" aria-current="page">Blog</span>
        </nav>

        {transformedPosts.length > 0 ? (
          <BlogIndexClient client:load posts={transformedPosts} />
        ) : (
          <div class="text-center py-12">
            <p class="text-secondary text-lg">No posts yet. Check back soon.</p>
            <a href="/" class="text-[var(--color-accent)] font-semibold hover:underline mt-4 inline-block">
              ← Back to Home
            </a>
          </div>
        )}
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
