# Copy to .env.local and fill in. Used for Supabase CLI (link, db push) when run from repo root.
# Do not commit .env.local.
#
# Optional: add PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY here
# so admin-dash-astro and programs both use the same project (required for published programs to appear on /programs).

# Supabase CLI: Personal Access Token from https://supabase.com/dashboard/account/tokens
# Required for supabase link and supabase db push (avoids 401 Unauthorized).
SUPABASE_ACCESS_TOKEN=

# Supabase CLI: Database password from Dashboard → Project Settings → Database (Connection string / reset password).
# Required for supabase db push so the CLI can connect to the remote database.
SUPABASE_DB_PASSWORD=
