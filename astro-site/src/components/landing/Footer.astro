---
// Footer component - Pure Astro (static HTML)
const currentYear = new Date().getFullYear();

const footerLinks = {
  product: [
    { name: 'Features', href: '/#features' },
    { name: 'Meet the Founder', href: '/#bio' },
    { name: 'Pricing', href: '/#pricing' },
    { name: 'Equipment Guide', href: '/equipment' },
    { name: 'Testimonials', href: '/#testimonials' },
    { name: 'FAQ', href: '/faq' },
  ],
  company: [
    { name: 'About', href: '/about' },
    { name: 'Founder Story', href: '/founder-story' },
    { name: 'Blog', href: '/blog' },
  ],
  support: [
    { name: 'Contact', href: 'mailto:support@aiworkoutgenerator.com' },
    { name: 'Help Center', href: '/faq' },
  ],
};

const socialLinks = [
  { name: 'X (Twitter)', href: 'https://x.com/AI_Workout', icon: 'x' },
  { name: 'Instagram', href: 'https://www.instagram.com/aiworkoutgenerator/', icon: 'instagram' },
  { name: 'YouTube', href: 'https://www.youtube.com/@aiworkoutgen', icon: 'youtube' },
];
---

<footer class="border-t border-[var(--glass-border-base)] py-12 md:py-16">
  <div class="container-custom">
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <!-- Lucide Activity (heartbeat/ECG) icon - matches Navbar logo -->
          <svg class="w-8 h-8 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
          </svg>
          <span class="font-bold text-lg">AI Workout Generator</span>
        </div>
        <p class="text-secondary text-sm max-w-xs mb-6">
          Science-based AI workout plans verified by certified trainers. Build muscle safely with our closed-loop engine.
        </p>
        <div class="flex gap-4">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-[var(--glass-bg-hover)] flex items-center justify-center hover:bg-[var(--color-accent)] hover:text-[var(--bg-dark)] transition-colors"
              aria-label={link.name}
            >
              {link.icon === 'x' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              )}
              {link.icon === 'instagram' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              )}
              {link.icon === 'youtube' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              )}
            </a>
          ))}
        </div>
      </div>
      
      <!-- Links -->
      <div>
        <h3 class="font-semibold mb-4">Product</h3>
        <ul class="space-y-2">
          {footerLinks.product.map((link) => (
            <li>
              <a href={link.href} class="text-secondary text-sm hover:text-[var(--color-accent)] transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <div>
        <h3 class="font-semibold mb-4">Company</h3>
        <ul class="space-y-2">
          {footerLinks.company.map((link) => (
            <li>
              <a href={link.href} class="text-secondary text-sm hover:text-[var(--color-accent)] transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <div>
        <h3 class="font-semibold mb-4">Support</h3>
        <ul class="space-y-2">
          {footerLinks.support.map((link) => (
            <li>
              <a href={link.href} class="text-secondary text-sm hover:text-[var(--color-accent)] transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[var(--glass-border-base)] flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-muted">
        &copy; {currentYear} AI Workout Generator. All rights reserved.
      </p>
      <p class="text-sm text-muted">
        San Diego, CA
      </p>
    </div>
  </div>
</footer>
