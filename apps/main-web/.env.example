# Site Configuration
NEXT_PUBLIC_SITE_URL=https://workoutgenerator.com

# ChatKit Studio Configuration
# Get your workflow ID from https://widgets.chatkit.studio
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=wf_691f16921c608190858a647f4c8459b60da29e275dd77b81

# OpenAI API Configuration (required for ChatKit)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Analytics & Tag Manager (optional)
# Get your GA4 Measurement ID from https://analytics.google.com
# Example: NEXT_PUBLIC_GA_ID=G-0ZT0ZEMBX5
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Get your GTM Container ID from https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Get your verification code from Google Search Console (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxx

# Stripe Payment Links
# Get your Payment Link URLs from https://dashboard.stripe.com/payment-links
# These are the checkout URLs for each pricing tier
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BASIC=your_stripe_payment_link_basic_here
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO=your_stripe_payment_link_pro_here
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_ELITE=your_stripe_payment_link_elite_here

# Admin (cookie-based; no Supabase in auth path). Min 16 characters.
ADMIN_PASSWORD=min16charsneeded

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostHog Configuration (optional)
# Get your Project API Key from https://app.posthog.com/project/settings
# Set your PostHog API key in a local, gitignored .env file. Do not commit real keys.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-api-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
