{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/explore",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://aiworkoutgenerator-admin.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://aiworkoutgenerator-admin.vercel.app/admin/:path*"
    },
    {
      "source": "/api/admin",
      "destination": "https://aiworkoutgenerator-admin.vercel.app/api/admin"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://aiworkoutgenerator-admin.vercel.app/api/admin/:path*"
    },
    {
      "source": "/exercises",
      "destination": "https://programs.aiworkoutgenerator.com/exercises"
    },
    {
      "source": "/exercises/:path*",
      "destination": "https://programs.aiworkoutgenerator.com/exercises/:path*"
    },
    {
      "source": "/learn",
      "destination": "https://programs.aiworkoutgenerator.com/learn"
    },
    {
      "source": "/learn/:path*",
      "destination": "https://programs.aiworkoutgenerator.com/learn/:path*"
    },
    {
      "source": "/programs",
      "destination": "https://programs.aiworkoutgenerator.com/programs"
    },
    {
      "source": "/programs/:path*",
      "destination": "https://programs.aiworkoutgenerator.com/programs/:path*"
    },
    {
      "source": "/challenges",
      "destination": "https://programs.aiworkoutgenerator.com/challenges"
    },
    {
      "source": "/challenges/:path*",
      "destination": "https://programs.aiworkoutgenerator.com/challenges/:path*"
    },
    {
      "source": "/workouts",
      "destination": "https://programs.aiworkoutgenerator.com/workouts"
    },
    {
      "source": "/workouts/:path*",
      "destination": "https://programs.aiworkoutgenerator.com/workouts/:path*"
    },
    {
      "source": "/_astro/:path*",
      "destination": "https://programs.aiworkoutgenerator.com/_astro/:path*"
    },
    {
      "source": "/site.webmanifest",
      "destination": "https://programs.aiworkoutgenerator.com/site.webmanifest"
    }
  ]
}
