---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/landing/Footer.astro';
import { buildBreadcrumbSchema } from '@/lib/breadcrumbSchema';

const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://aiworkoutgenerator.com';

const pageTitle = 'Exercise Challenge | AI Workout Generator';
const pageDescription = 'Take the Fitcopilot Vision Lab exercise challenge. Visualize technique and get personalized AI workout recommendations.';

const breadcrumbSchema = buildBreadcrumbSchema(baseUrl, [
  { name: 'Home', url: baseUrl },
  { name: 'Exercise Challenge', url: `${baseUrl}/exercise-challenge` },
]);

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: `${baseUrl}/exercise-challenge`,
  mainEntity: {
    '@type': 'SoftwareApplication',
    name: 'AI Workout Generator Vision Lab',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${baseUrl}/exercise-challenge`}
  structuredData={[webPageSchema, breadcrumbSchema]}
>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative py-20 md:py-32 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--glass-bg-hover)] to-transparent"></div>
      <div class="container-custom relative">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block px-4 py-1.5 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] text-sm font-semibold mb-6">
            Vision Lab
          </span>
          <h1 class="text-4xl md:text-5xl font-extrabold mb-6">
            Fitcopilot Vision Lab
          </h1>
          <p class="text-xl text-secondary mb-8">
            Visualize technique — then tell us what you'd expect from an AI workout generator.
          </p>
        </div>
      </div>
    </section>

    <!-- Feature Cards -->
    <section class="py-16">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <div class="grid md:grid-cols-3 gap-6 mb-12">
            <div class="glass-card-strong rounded-xl p-6 text-center">
              <div class="w-14 h-14 rounded-full bg-[var(--color-accent)]/10 flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <h3 class="font-bold mb-2">Visualize</h3>
              <p class="text-sm text-secondary">See proper exercise technique before you train</p>
            </div>
            
            <div class="glass-card-strong rounded-xl p-6 text-center">
              <div class="w-14 h-14 rounded-full bg-[var(--color-accent)]/10 flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <h3 class="font-bold mb-2">Learn</h3>
              <p class="text-sm text-secondary">Understand form cues and movement patterns</p>
            </div>
            
            <div class="glass-card-strong rounded-xl p-6 text-center">
              <div class="w-14 h-14 rounded-full bg-[var(--color-accent)]/10 flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="font-bold mb-2">Generate</h3>
              <p class="text-sm text-secondary">Get AI-powered workout recommendations</p>
            </div>
          </div>

          <!-- CTA Card -->
          <div class="glass-card-strong rounded-2xl p-8 md:p-12 text-center">
            <h2 class="text-2xl md:text-3xl font-bold mb-4">
              Ready to Build Your Workout?
            </h2>
            <p class="text-secondary mb-8 max-w-lg mx-auto">
              Skip the visualization and get straight to your personalized AI-generated workout plan. 
              Tell us your goals, equipment, and preferences — we'll create your program.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/onboard" class="btn-onboard-cta">
                Generate Your Workout
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <a 
                href="/onboarding"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-[var(--glass-border-base)] bg-[var(--glass-bg-base)] text-primary font-semibold hover:bg-[var(--glass-bg-hover)] transition-all hover:-translate-y-0.5"
              >
                Try Quick Builder
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-16 bg-[var(--glass-bg-base)]">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-bold text-center mb-12">How AI Workout Generator Works</h2>
          
          <div class="space-y-6">
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[var(--color-accent)] text-[var(--bg-dark)] flex items-center justify-center font-bold">
                1
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">Tell Us About Yourself</h3>
                <p class="text-secondary">Share your fitness goals, available equipment, and any limitations or preferences.</p>
              </div>
            </div>
            
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[var(--color-accent)] text-[var(--bg-dark)] flex items-center justify-center font-bold">
                2
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">AI Generates Your Plan</h3>
                <p class="text-secondary">Our trainer-verified AI creates a science-based program tailored to your inputs.</p>
              </div>
            </div>
            
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[var(--color-accent)] text-[var(--bg-dark)] flex items-center justify-center font-bold">
                3
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">Train With Confidence</h3>
                <p class="text-secondary">Follow your personalized workout with proper progression and safety built in.</p>
              </div>
            </div>
          </div>
          
          <div class="text-center mt-12">
            <a 
              href="/faq"
              class="text-[var(--color-accent)] font-semibold hover:underline"
            >
              Have questions? Check our FAQ →
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
