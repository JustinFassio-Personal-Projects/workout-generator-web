# Supabase (same project as programs/astro-site for shared admin). All required; no defaults (fail fast).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Required for admin users list (auth.admin.listUsers). From Supabase Dashboard > Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: main site URL for "Return to site" link
PUBLIC_SITE_URL=https://aiworkoutgenerator.com

# Program CRUD uses programs + program_weeks tables (same Supabase as programs).
# SUPABASE_SERVICE_ROLE_KEY already required for admin users.

# AI routes (Generate with AI) — Vertex AI / DeepSeek. Required for program generation; omit to disable.
# Use the same GCP project as programs app. See apps/programs/docs/services/vertex-ai-permissions.md.
# Set one: GOOGLE_PROJECT_ID or PUBLIC_FIREBASE_PROJECT_ID (e.g. ai-fitness-guy-26523278-3e978).
# GOOGLE_PROJECT_ID=ai-fitness-guy-26523278-3e978
# GOOGLE_LOCATION=us-central1

# Equipment & Zones: /admin/zones requires tables equipment_inventory and equipment_zones.
# See apps/admin-dash-astro/docs/EQUIPMENT_SCHEMA.md for migration SQL if missing.

# Optional: admin base path (default /admin)
# PUBLIC_ADMIN_BASE_PATH=/admin

# Vercel (set automatically on Vercel)
# VERCEL=1
