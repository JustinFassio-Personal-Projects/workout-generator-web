{
  "name": "ai-workout-generator-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack --port 3000",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' next build --webpack",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.config.mjs",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.config.mjs --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:emulator": "firebase emulators:exec --only auth,firestore 'vitest run'",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:smoke:ui": "playwright test tests/smoke.spec.ts --ui",
    "test:critical": "vitest run -t \"@critical\"",
    "security:scan": "node scripts/security-scan.js",
    "verify:quick": "npm run type-check && npm run build",
    "verify:all": "npm run lint && npm run format:check && npm run type-check && npm run test:run && npm run security:scan && npm run build",
    "verify:deploy": "npm run verify:all && npm run test:emulator",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy-firestore": "firebase deploy --only firestore",
    "firebase:deploy-storage": "firebase deploy --only storage",
    "seed:firestore:prod": "tsx scripts/seed-firestore-schema.ts --project ai-workout-generator-hub --confirm-production",
    "seed:firestore:prod:dry": "tsx scripts/seed-firestore-schema.ts --project ai-workout-generator-hub --dry-run",
    "seed:firestore:emulator": "tsx scripts/seed-firestore-schema.ts --project ai-workout-generator-hub --emulator",
    "seed:workout-summaries:emulator": "tsx scripts/seed-workout-summaries-emulator.ts --emulator",
    "create:pro-user": "tsx scripts/create-pro-user.ts",
    "sync:rules:admin": "tsx scripts/sync-firestore-rules-to-admin.ts",
    "sync:rules:admin:dry": "tsx scripts/sync-firestore-rules-to-admin.ts --dry-run",
    "check-deps": "npx depcheck",
    "prepare": "[ -d node_modules/husky ] && husky install || echo 'Husky not installed (expected in CI/production builds)'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@genkit-ai/googleai": "^1.27.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.38.0",
    "@stripe/stripe-js": "^8.6.0",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.7.0",
    "firebase-admin": "^12.0.0",
    "genkit": "^1.27.0",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.562.0",
    "next": "16.0.8",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.324.0",
    "posthog-node": "^5.21.0",
    "react": "19.2.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.69.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^20.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "use-sound": "^4.0.4",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "depcheck": "^1.4.7",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.1.0",
    "hono": "^4.11.3",
    "husky": "^8.0.0",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.16"
  }
}
