{
  "extends": "../../node_modules/astro/tsconfigs/strict.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node", "astro/client"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },
    "baseUrl": ".",
    "strict": true,
    "noEmit": true
  },
  "include": ["src/**/*"]
}
