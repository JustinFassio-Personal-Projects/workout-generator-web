# Supabase (required for admin data and auth). Do not commit real keys; use .env.local.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin session (password-based login; min 16 chars). Do not commit real password.
ADMIN_PASSWORD=your_admin_password_here
# Or use ADMIN_SECRET instead of ADMIN_PASSWORD

# Optional: link back to main site
NEXT_PUBLIC_SITE_URL=https://your-site.com

# Optional: main site revalidation (deploy hook or cache-purge URL). When set,
# admin-dash will POST to this URL after blog/deep-research mutations (fire-and-forget).
# MAIN_SITE_REVALIDATE_URL=https://api.vercel.com/v1/integrations/deploy/...
# MAIN_SITE_REVALIDATE_SECRET=optional-secret-for-x-revalidate-secret-header
