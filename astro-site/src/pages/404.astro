---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/landing/Footer.astro';
---

<BaseLayout 
  title="Page Not Found" 
  description="The page you're looking for doesn't exist or has been moved."
  noindex={true}
>
  <main class="min-h-screen flex flex-col">
    <section class="flex-1 flex items-center justify-center section-padding">
      <div class="container-custom text-center">
        <div class="max-w-2xl mx-auto" data-aos="fade-up">
          <!-- 404 Icon -->
          <div class="mb-8">
            <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-[var(--glass-bg-hover)] text-[var(--color-accent)]">
              <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
              </svg>
            </div>
          </div>

          <!-- Error Message -->
          <h1 class="text-6xl md:text-8xl font-extrabold text-[var(--color-accent)] mb-4">
            404
          </h1>
          <h2 class="text-2xl md:text-3xl font-bold mb-4">
            Page Not Found
          </h2>
          <p class="text-lg text-secondary mb-8 max-w-md mx-auto">
            The page you're looking for doesn't exist or has been moved. 
            Let's get you back on track.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="/"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[var(--color-accent)] text-[var(--bg-dark)] font-semibold hover:bg-[var(--color-accent-light)] transition-all hover:-translate-y-0.5 shadow-lg"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              Go Home
            </a>
            <a 
              href="/blog"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-[var(--glass-border-base)] bg-[var(--glass-bg-base)] text-primary font-semibold hover:bg-[var(--glass-bg-hover)] transition-all hover:-translate-y-0.5"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              Read Blog
            </a>
          </div>

          <!-- Quick Links -->
          <div class="mt-12 pt-8 border-t border-[var(--glass-border-base)]">
            <p class="text-sm text-muted mb-4">Popular destinations:</p>
            <div class="flex flex-wrap gap-3 justify-center">
              <a href="/about" class="text-sm text-secondary hover:text-[var(--color-accent)] transition-colors">About</a>
              <span class="text-muted">•</span>
              <a href="/faq" class="text-sm text-secondary hover:text-[var(--color-accent)] transition-colors">FAQ</a>
              <span class="text-muted">•</span>
              <a href="/equipment" class="text-sm text-secondary hover:text-[var(--color-accent)] transition-colors">Equipment Guide</a>
              <span class="text-muted">•</span>
              <a href="/reports" class="text-sm text-secondary hover:text-[var(--color-accent)] transition-colors">Reports</a>
              <span class="text-muted">•</span>
              <a href="/founder-story" class="text-sm text-secondary hover:text-[var(--color-accent)] transition-colors">Founder Story</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <Footer />
  </main>
</BaseLayout>
