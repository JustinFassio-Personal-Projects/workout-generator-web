# Copy to .env.local and fill in values.
# Required for local development (see PRE_PR_CHECKLIST.md).

# Supabase (required) - URL must be https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Required for server/API (program-service, etc.). Get from Dashboard → Settings → API → service_role. Add to .env.local and Vercel.
# SUPABASE_ACCESS_TOKEN=     # Optional: for Supabase CLI (link); copy to .env.local
# SUPABASE_DB_PASSWORD=      # Required for supabase db push. Get from Dashboard → Project Settings → Database (reset if needed)

# Optional: for specific features
# GEMINI_API_KEY=           # Deep dive generation, Veo video generation (Generate with Gemini)
# RUNWAYML_API_SECRET=      # Admin exercise video generation (Runway ML, Generate with Runway)

# --- Vercel (production) ---
# In Vercel: Project → Settings → Environment Variables. Add:
#   PUBLIC_SUPABASE_URL     = https://<project-ref>.supabase.co
#   PUBLIC_SUPABASE_ANON_KEY = anon JWT (Dashboard → API → anon public)
#   SUPABASE_SERVICE_ROLE_KEY = service_role JWT (Dashboard → API → service_role) — keep secret, do not expose to client.
# Apply to Production (and Preview if you use Supabase there).
