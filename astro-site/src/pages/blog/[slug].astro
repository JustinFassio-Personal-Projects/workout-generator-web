---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/landing/Footer.astro';
import PostHero from '@/components/blog/PostHero.astro';
import PostContent from '@/components/blog/PostContent.astro';
import { getPostBySlug, getRelatedPosts, toTransformedPost } from '@/lib/blog/queries';
import { buildBreadcrumbSchema } from '@/lib/breadcrumbSchema';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const post = await getPostBySlug(slug, Astro.cookies);

if (!post) {
  return Astro.redirect('/404');
}

const relatedPosts = await getRelatedPosts(post, Astro.cookies, 3);
const transformedPost = toTransformedPost(post);

const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://aiworkoutgenerator.com';
const url = `${baseUrl}/blog/${post.slug}`;
const publishedTime = post.published_at || post.created_at;
const modifiedTime = post.updated_at;

const heroImage = post.featured_image
  ? post.featured_image.startsWith('http')
    ? post.featured_image
    : `${baseUrl}${post.featured_image}`
  : `${baseUrl}/og-image.jpg`;

const wordCount = post.content.split(/\s+/).filter((word: string) => word.length > 0).length;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));

const pageTitle = post.seo_title || `${post.title} | Blog`;
const pageDescription =
  post.seo_description ||
  (post.excerpt.length > 160 ? post.excerpt.substring(0, 157).trim() + '...' : post.excerpt);

const breadcrumbSchema = buildBreadcrumbSchema(baseUrl, [
  { name: 'Home', url: baseUrl },
  { name: 'Blog', url: `${baseUrl}/blog` },
  { name: post.title, url },
]);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: pageDescription,
  image: heroImage,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  wordCount,
  author: {
    '@type': 'Person',
    name: post.author?.name || 'Unknown',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Workout Generator',
    logo: {
      '@type': 'ImageObject',
      url: `${baseUrl}/logo.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
  articleSection: post.category?.name || 'Uncategorized',
  keywords: (post.tags || []).join(', '),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={url}
  ogImage={heroImage}
  ogType="article"
  structuredData={[breadcrumbSchema, articleSchema]}
>
  <main class="min-h-screen">
    <PostHero
      post={transformedPost}
      heroImage={heroImage}
      readingTimeMinutes={readingTimeMinutes}
    />
    <PostContent content={post.content} />

    {relatedPosts.length > 0 && (
      <section class="container-custom py-16 border-t border-[var(--glass-border-base)]">
        <h2 class="text-2xl font-bold mb-6">Related articles</h2>
        <ul class="grid md:grid-cols-3 gap-6">
          {relatedPosts.map((p) => {
            const transformed = toTransformedPost(p);
            return (
              <li>
                <a
                  href={`/blog/${p.slug}`}
                  class="block p-4 rounded-lg bg-[var(--glass-bg-base)] hover:bg-[var(--glass-bg-hover)] transition-colors"
                >
                  <span class="font-semibold text-primary">{transformed.title}</span>
                  <span class="text-sm text-secondary block mt-1">{transformed.category}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <Footer />
  </main>
</BaseLayout>
