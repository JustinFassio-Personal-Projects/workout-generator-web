---
import '@workout-generator/design-system';
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Admin Dashboard' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#0d0500" />
  </head>
  <body>
    <slot />
  </body>
</html>
