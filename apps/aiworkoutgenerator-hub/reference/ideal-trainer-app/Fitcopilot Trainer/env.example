# Environment Variables Example
# Copy this file to .env.local and fill in your actual values
# .env.local is git-ignored and will not be committed

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# IMPORTANT: These credentials must match the Hub app exactly
# All apps (Hub, Trainer, Chef) share the same Supabase project

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ============================================
# HUB CONFIGURATION (Required)
# ============================================

# Hub URL for SSO and navigation links
# Production Hub URL
NEXT_PUBLIC_HUB_URL=https://www.fitcopilot.app

# For local development:
# NEXT_PUBLIC_HUB_URL=http://localhost:5175

# ============================================
# GEMINI API (Optional)
# ============================================

# Gemini API Key for AI-powered workout generation
# Optional: App will work without it (manual workout creation only)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# DEBUG SETTINGS (Optional)
# ============================================

# Enable debug logging
# NEXT_PUBLIC_DEBUG=true
# NEXT_PUBLIC_LOG_LEVEL=debug

# ============================================
# SECURITY NOTES
# ============================================

# ❌ DO NOT SET NEXT_PUBLIC_SUPABASE_JWT_SECRET
# JWT secret should NEVER be in client code - it's a SECURITY RISK!
# The JWT secret exists ONLY in the Hub's Edge Function (server-side)
# Token validation happens server-side via Supabase auth.setSession()

# ============================================
# ARCHITECTURE NOTES
# ============================================

# 1. Multi-Schema Architecture: Trainer uses 'trainer' schema
#    - All workout/exercise queries use .schema('trainer')
#    - User profiles remain in 'public' schema (shared with Hub)
#
# 2. No SSO needed - same Supabase auth across all apps
#    - Hub, Trainer, and Chef share the same authentication
#    - Users authenticate once and access all apps
#
# 3. After updating .env.local, restart your dev server:
#    npm run dev
