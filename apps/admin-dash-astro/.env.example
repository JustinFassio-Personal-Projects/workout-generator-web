# Supabase (same project as programs for shared admin). All required; no defaults (fail fast).
# For this app use: https://qbklyimfazrkutwqictw.supabase.co (set PUBLIC_SUPABASE_URL to this).
# Tables (generated_exercises, exercise_images), analytics (analytics_funnel_events, web_events, errors_frontend), and bucket (exercise-images) must exist — see docs.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Required for admin users list (auth.admin.listUsers). From Supabase Dashboard > Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: main site URL for "Return to site" link
PUBLIC_SITE_URL=https://aiworkoutgenerator.com

# Optional: IANA timezone for Manage Users quick stats + Created column (default America/Los_Angeles).
# PUBLIC_ADMIN_STATS_TIMEZONE=America/Los_Angeles

# Visualization Lab (Exercise Image Generator): required for /admin/exercise-image-gen.
# Get an API key from Google AI Studio (aistudio.google.com) and set for research + image generation.
# GEMINI_API_KEY=

# Active Growth Engine — optional LLM narrative on daily brief (Phase G). Requires GEMINI_API_KEY when enabled.
# When unset or false, batch job stays rules-only (no Gemini call).
# GROWTH_ENGINE_NARRATIVE_ENABLED=true
# After reverse-trial Phases 1–2 are verified in production: set on the batch/cron host only so the Marketing card reflects real growth_state segmentation (see docs/REVERSE_TRIAL_ROADMAP.md Phase 4).
# GROWTH_STATE_READY=true
# Pipeline user source: firebase (hub Firestore users) or supabase (legacy profiles).
# Defaults to firebase when FIREBASE_SERVICE_ACCOUNT_KEY is configured.
# GROWTH_PIPELINE_USER_SOURCE=firebase
# When pipeline source is firebase, still run Supabase growth_state reconcile on each batch (profiles backfill / sync parity).
# GROWTH_RECONCILE_PROFILES_ON_BATCH=false

# Hub → Supabase profile mirror: Firestore `users` marketing slice → `profiles` (firebase_uid + RPC upsert_profile_from_hub).
# Chain order in batch: hub sync (if enabled) → reconcile → rest. See ACTIVE_GROWTH_ENGINE_ROADMAP §Phase D and migration 20260328100000_hub_profile_firebase_sync.sql.
# HUB_PROFILE_SYNC_ON_BATCH=false
# Max Firestore user docs per batch run (default 2000, clamped 50–10000).
# HUB_PROFILE_SYNC_MAX_DOCS=2000

# Phase 5 — Lifecycle automation (REVERSE_TRIAL_ROADMAP). Off by default.
# LIFECYCLE_AUTOMATION_ENABLED=true
# Dry-run logs rows to lifecycle_send_log with status dry_run; production sends require LIFECYCLE_SENDS_ENABLED and a wired email API (see docs).
# LIFECYCLE_AUTOMATION_DRY_RUN=true
# LIFECYCLE_SENDS_ENABLED=false
# Optional: chain job after Growth Engine batch (same cron key as /api/admin/growth-engine/jobs/batch).
# LIFECYCLE_JOB_ON_BATCH=false
# Caps & batch size
# LIFECYCLE_MAX_TOUCHES_PER_USER_PER_WEEK=3
# LIFECYCLE_PROFILE_BATCH_LIMIT=2000
# Optional Resend key when implementing transactional sends (job still records skipped_no_provider until send path exists).
# RESEND_API_KEY=
# Optional UUID of an admin user to receive one intervention_logs row per batch with job summary metadata.
# LIFECYCLE_INTERVENTION_ACTOR_ID=

# Program CRUD uses programs + program_weeks tables (same Supabase as programs).
# SUPABASE_SERVICE_ROLE_KEY already required for admin users.

# AI routes (Generate with AI) — Vertex AI / DeepSeek. Required for program generation; omit to disable.
# Use the same GCP project as programs app. See apps/programs/docs/services/vertex-ai-permissions.md.
# Set one: GOOGLE_PROJECT_ID or PUBLIC_FIREBASE_PROJECT_ID (e.g. your-gcp-project-id).
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GOOGLE_LOCATION=your-gcp-location
# On Vercel/production: set GOOGLE_APPLICATION_CREDENTIALS_JSON to the full service account key JSON (single line). Locally you can use gcloud auth application-default login instead.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Equipment & Zones: /admin/zones requires tables equipment_inventory and equipment_zones.
# See apps/admin-dash-astro/docs/EQUIPMENT_SCHEMA.md for migration SQL if missing.

# Optional: admin base path (default /admin)
# PUBLIC_ADMIN_BASE_PATH=/admin

# Optional: Firebase Auth for Handoff / hub signup counts.
# Use hub project service account (ai-workout-generator-hub). Omit to disable; admin works without it.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...",...}
# FIREBASE_PROJECT_ID=ai-workout-generator-hub
# For Retention & cohorts: service account needs Cloud Datastore User (or Firebase Admin) to read user_activity_logs.

# Vercel (set automatically on Vercel)
# VERCEL=1
