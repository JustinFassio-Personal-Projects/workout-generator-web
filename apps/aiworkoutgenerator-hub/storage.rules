rules_version = '2';
// Firebase Storage rules for gs://ai-workout-generator-hub.firebasestorage.app
// Bucket folders: exercises/, trainer-banners/, trainer-profiles/, exercise-images/
service firebase.storage {
  match /b/{bucket}/o {
    // exercises/ - master/curated exercise images (admin-managed)
    match /exercises/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['admin', 'super_admin'];
    }
    // exercise-images/master/ - master images (admin-managed)
    match /exercise-images/master/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['admin', 'super_admin'];
    }
    // exercise-images/{workoutId}/ - user workout images + AI-generated; scope write to workout owner
    match /exercise-images/{workoutId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/workouts/$(workoutId))
        && firestore.get(/databases/(default)/documents/workouts/$(workoutId)).data.user_id == request.auth.uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5MB max
    }
    // trainer-banners/ - trainer banner images (admin-managed)
    match /trainer-banners/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['admin', 'super_admin'];
    }
    // trainer-profiles/ - trainer profile images (admin-managed)
    match /trainer-profiles/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['admin', 'super_admin'];
    }
  }
}
