---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/landing/Footer.astro';
import { getChaptersByOrder } from '@/data/story-chapters';

const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://aiworkoutgenerator.com';
const chapters = getChaptersByOrder();

// WebPage structured data
const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${baseUrl}/founder-story`,
  name: 'Founder Story | AIWorkoutGenerator',
  description:
    'The story of how coaching expertise and software development came together to create AIWorkoutGenerator.',
  url: `${baseUrl}/founder-story`,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    name: 'AIWorkoutGenerator',
    url: baseUrl,
  },
  about: {
    '@type': 'Person',
    name: 'Justin Fassio',
    jobTitle: 'Founder',
    description:
      'Certified trainer since 1996, TACP veteran, founder of San Diego Core Fitness, and builder of fitness software platforms.',
  },
};

// BreadcrumbList structured data
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: baseUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Founder Story',
      item: `${baseUrl}/founder-story`,
    },
  ],
};
---

<BaseLayout
  title="Founder Story | AIWorkoutGenerator"
  description="I built AIWorkoutGenerator because most 'AI workouts' are just randomness with confidence. Learn the story of how coaching expertise and software development came together."
  canonicalUrl={`${baseUrl}/founder-story`}
  structuredData={[webpageSchema, breadcrumbSchema]}
>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="section-padding text-center">
      <div class="container-custom">
        <span class="text-[#0ea5e9] font-bold tracking-wider uppercase text-sm">
          Our Story
        </span>
        <h1 class="mt-4 text-4xl md:text-5xl font-extrabold">
          Founder Story
        </h1>
        <p class="mt-6 text-lg md:text-xl text-secondary max-w-3xl mx-auto">
          I built AIWorkoutGenerator because most "AI workouts" are just randomness with confidence. 
          I've coached long enough to know what works — and I've built enough software to know what scales. 
          This is the story of how those two worlds collided.
        </p>
      </div>
    </section>

    <!-- Profile Image Section -->
    <section class="py-8 md:py-12">
      <div class="container-custom">
        <div class="flex flex-col items-center gap-4">
          <p class="text-sm text-tertiary text-center italic">
            Training Boot Camp Instructors in San Diego, CA
          </p>
          <div class="w-full max-w-lg mx-auto rounded-xl overflow-hidden shadow-2xl glass-card-strong p-2 hover:-translate-y-2 transition-transform duration-300">
            <img
              src="/justin-fassio-ai-workout-generator-founder-san-diego-trainer.jpg"
              alt="Justin Fassio - Founder of AIWorkoutGenerator"
              width="500"
              height="375"
              class="w-full h-auto rounded-lg"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Narrative Section -->
    <section class="py-8 md:py-16">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto space-y-6 text-lg text-secondary leading-relaxed">
          <p>
            I grew up in the coastal community of <strong class="text-primary">Santa Cruz, California</strong>,
            where fitness wasn't a "program" — it was surfing, moving, getting outside, and building 
            capability without overthinking it. That early relationship with training stuck: 
            performance matters, but it has to feel real.
          </p>

          <p>
            Later, I joined the <strong class="text-primary">U.S. Air Force</strong> and served as a 
            <strong class="text-primary">Tactical Air Control Party (TACP)</strong> member. That environment
            doesn't reward hype — it rewards readiness. You learn fast that physical training is not 
            about looking fit; it's about being fit when it counts.
          </p>

          <p>
            At <strong class="text-primary">Fort Hood</strong>, I was given a waiver as an 
            <strong class="text-primary">Airman First Class</strong> to run unit fitness programming as 
            <strong class="text-primary">Master Fitness Trainer / Unit Fitness Program Manager</strong> for a 
            <strong class="text-primary">3rd Air Support Operations Group</strong> unit (11th ASOS). That role
            taught me how to build training for a population — how to reduce injuries, manage compliance, 
            and create consistency across different fitness levels.
          </p>

          <p>
            After the military, I earned a degree in 
            <strong class="text-primary">Literature from UC Santa Cruz</strong> and completed graduate coursework
            in <strong class="text-primary">Critical Theory and Semiotics</strong>. That might sound unrelated —
            but it trained me to think about systems, meaning, and human behavior. In fitness,
            the best plan is the one people actually follow.
          </p>

          <p>
            I went on to build <strong class="text-primary">San Diego Core Fitness</strong>, then moved deeper into
            technology — designing products like <strong class="text-primary">GymGo</strong> and 
            <strong class="text-primary">FitNimbus</strong> — because I kept seeing the same issue: coaching is
            powerful, but it doesn't scale without good infrastructure.
          </p>

          <p>
            AIWorkoutGenerator is the result of that whole path: coaching + systems + software + AI, 
            built with one non-negotiable rule: 
            <strong class="text-primary">the workout must make sense for the person doing it.</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- Chapters Section -->
    <section class="py-16 md:py-24 bg-[var(--glass-bg-base)]">
      <div class="container-custom">
        <div class="text-center mb-12 md:mb-16 max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Explore the chapters</h2>
          <p class="text-lg text-secondary">
            Each chapter tells a different part of the story — from Santa Cruz to the Air Force
            to building fitness software.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {chapters.map((chapter, index) => (
            <a 
              href={`/story/${chapter.slug}`}
              class="glass-card p-6 group"
            >
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex items-center justify-center font-bold text-lg">
                  {chapter.order}
                </span>
                <div>
                  <h3 class="font-bold text-lg mb-2 group-hover:text-[var(--color-accent)] transition-colors">
                    {chapter.title}
                  </h3>
                  <p class="text-sm text-secondary">
                    {chapter.description}
                  </p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Principles Section -->
    <section class="py-16 md:py-24">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12">
            Principles that power the product
          </h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="glass-card p-6">
              <h3 class="text-xl font-bold mb-3 gradient-text">Safety</h3>
              <p class="text-secondary">
                Every workout is constrained by safety principles. No random exercises that
                could cause injury.
              </p>
            </div>
            <div class="glass-card p-6">
              <h3 class="text-xl font-bold mb-3 gradient-text">Progression</h3>
              <p class="text-secondary">
                Workouts adapt and progress over time, following real training principles, not
                arbitrary complexity.
              </p>
            </div>
            <div class="glass-card p-6">
              <h3 class="text-xl font-bold mb-3 gradient-text">Adaptability</h3>
              <p class="text-secondary">
                Programs adjust to equipment, time, goals, and fitness level — because the best
                plan is the one you can actually do.
              </p>
            </div>
            <div class="glass-card p-6">
              <h3 class="text-xl font-bold mb-3 gradient-text">Scale</h3>
              <p class="text-secondary">
                Good coaching principles, automated intelligently, so quality doesn't
                degrade with volume.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 md:py-24 bg-gradient-to-br from-[var(--color-accent)]/5 to-[var(--color-primary-400)]/5">
      <div class="container-custom">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-extrabold mb-4">
            Want the system I wish I had back then?
          </h2>
          <p class="text-lg text-secondary mb-8">
            Generate your first workout and experience how real coaching principles meet
            intelligent automation.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="/"
              class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-[var(--color-accent)] text-[var(--bg-dark)] font-semibold hover:bg-[var(--color-accent-light)] transition-colors"
            >
              Generate Your Workout
            </a>
            <a 
              href="/about"
              class="inline-flex items-center justify-center px-8 py-4 rounded-xl border border-[var(--glass-border-hover)] text-[var(--text-primary)] font-semibold hover:bg-[var(--glass-bg-hover)] transition-colors"
            >
              Learn More About Us
            </a>
          </div>
        </div>
      </div>
    </section>
    
    <Footer />
  </main>
</BaseLayout>
