---
// Onboarding wizard with animated intro: goals, equipment, profile, then loading sequence and redirect to signup.
// Query param ?preselect=dumbbells (or kettlebells, barbell, etc.) pre-fills fitness level and equipment.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/landing/Footer.astro';
import { OnboardingWizard } from '@/components/react/OnboardingWizard/OnboardingWizard';

const preselect = Astro.url.searchParams.get('preselect');
---

<BaseLayout
  title="Build Your Workout Plan | AI Workout Generator"
  description="Answer a few questions about your goals and equipment. Create your account to generate and save your personalized AI workout plan."
>
  <main class="min-h-screen flex flex-col">
    <div class="flex-1">
      <OnboardingWizard client:load preselect={preselect} />
    </div>
    <Footer />
  </main>
</BaseLayout>
