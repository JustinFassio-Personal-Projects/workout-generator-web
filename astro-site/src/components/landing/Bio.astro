---
import styles from './Bio.module.scss'

const credentials = [
  'Certified trainer since 1996 (ACSM CPT)',
  'U.S. Air Force TACP veteran; served as MFT/UFPM for a 3rd ASOG unit at Fort Hood',
  'Founder: San Diego Core Fitness',
  'Builder/designer: GymGo, FitNimbus, and now AIWorkoutGenerator / Fitcopilot',
]

const socialLinks = [
  { href: 'https://www.youtube.com/@aiworkoutgen', label: 'YouTube', icon: 'youtube' },
  { href: 'https://www.instagram.com/aiworkoutgenerator/', label: 'Instagram', icon: 'instagram' },
  { href: 'https://www.linkedin.com/in/justinfassio/', label: 'LinkedIn Personal', icon: 'linkedin' },
  { href: 'https://www.linkedin.com/company/ai-workout-generator/', label: 'LinkedIn Company', icon: 'linkedin' },
  { href: 'https://www.facebook.com/aiworkoutgenerator', label: 'Facebook', icon: 'facebook' },
  { href: 'https://x.com/AI_Workout', label: 'Twitter', icon: 'x' },
  { href: 'https://www.yelp.com/biz/san-diego-core-fitness-san-diego-san-diego?osq=San+Diego+Core+Fitness', label: 'Yelp Reviews', icon: 'yelp' },
]

const galleryImages = [
  { src: '/justin-profile-section-2.png', alt: 'Justin Fassio training clients in San Diego' },
  { src: '/justin-profile-section-3.png', alt: 'Justin Fassio - Personal Trainer and Fitness Coach' },
  { src: '/justin-profile-section-4.png', alt: 'Justin Fassio - Military Fitness Trainer and Coach' },
]
---

<section id="bio" class={styles.bio}>
  <div class={styles.container}>
    <div class={styles.layout}>
      <div class={styles.imageSection} data-aos="fade-right">
        <div class={styles.mainImageWrapper}>
          <img
            src="/justin-fassio-ai-workout-generator-founder-san-diego-trainer.jpg"
            alt="Justin Fassio - Certified Personal Trainer and Founder of AIWorkoutGenerator in San Diego, CA"
            class={styles.mainImage}
            width="600"
            height="800"
            loading="lazy"
          />
        </div>
        <div class={styles.imageGallery}>
          {galleryImages.map((img) => (
            <div class={styles.galleryImage}>
              <img
                src={img.src}
                alt={img.alt}
                class={styles.galleryImg}
                width="150"
                height="150"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>

      <div class={styles.content} data-aos="fade-left">
        <div class={styles.bioHeader}>
          <h2 class={styles.title}>
            <span class={styles.gradientText}>Built by a coach, not a prompt.</span>
          </h2>
          <div class={styles.bioText}>
            <p>
              Hi — I'm <strong>Justin Fassio</strong>. I've been a certified trainer
              since <strong>1996</strong>, ran military fitness programming for an Air Support
              Operations unit, built real-world training businesses, and later designed fitness
              software platforms before stepping into AI.
            </p>
            <p>
              AIWorkoutGenerator exists for one reason:{' '}
              <strong>
                to give people structured training that's safe, personalized, and
                consistent — not random workouts.
              </strong>
            </p>
          </div>
        </div>

        <div class={styles.credentials}>
          <h3 class={styles.credentialsTitle}>
            Expertise and Experience Behind Every Workout:
          </h3>
          <ul class={styles.credentialsList}>
            {credentials.map((credential) => (
              <li class={styles.credentialItem}>
                <svg class={styles.checkIcon} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{credential}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class={styles.ctaSection} data-aos="fade-up" data-aos-delay="200">
      <div class={styles.actions}>
        <a href="/founder-story" class={`${styles.ctaLink} ${styles['ctaLink--primary']}`} data-cta="bio-founder-story">
          Read the Founder Story
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/onboarding" class={`${styles.ctaLink} ${styles['ctaLink--secondary']}`} data-cta="bio-generate-workout">
          Generate My First Workout
        </a>
        <a
          href="https://www.linkedin.com/in/justinfassio/"
          target="_blank"
          rel="noopener noreferrer"
          class={`${styles.ctaLink} ${styles['ctaLink--secondary']}`}
          data-cta="bio-linkedin"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          Connect on LinkedIn
        </a>
      </div>
      <div class={styles.socialLinks}>
        {socialLinks.map((social) => (
          <a
            href={social.href}
            aria-label={social.label}
            target="_blank"
            rel="noopener noreferrer"
            class={styles.socialLink}
          >
            {social.icon === 'youtube' && (
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            )}
            {social.icon === 'instagram' && (
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            )}
            {social.icon === 'linkedin' && (
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            )}
            {social.icon === 'facebook' && (
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            )}
            {social.icon === 'x' && (
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            )}
            {social.icon === 'yelp' && (
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
