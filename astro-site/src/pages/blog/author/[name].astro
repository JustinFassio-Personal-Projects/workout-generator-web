---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/landing/Footer.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import { getAuthorBySlug, getPostsByAuthor, toTransformedPost } from '@/lib/blog/queries';
import { buildBreadcrumbSchema } from '@/lib/breadcrumbSchema';

export const prerender = false;

const { name } = Astro.params;

if (!name) {
  return Astro.redirect('/blog');
}

const author = await getAuthorBySlug(name, Astro.cookies);
const posts = await getPostsByAuthor(name, Astro.cookies);

if (!author) {
  return Astro.redirect('/404');
}

const transformedPosts = posts.map(toTransformedPost);

const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://aiworkoutgenerator.com';

const pageTitle = `Articles by ${author.name} | Blog`;
const pageDescription = author.bio || 
  `Read all articles by ${author.name} on the AI Workout Generator blog. Fitness tips, workout strategies, and expert advice.`;

// Breadcrumb schema
const breadcrumbSchema = buildBreadcrumbSchema(baseUrl, [
  { name: 'Home', url: baseUrl },
  { name: 'Blog', url: `${baseUrl}/blog` },
  { name: author.name, url: `${baseUrl}/blog/author/${name}` },
]);

// Author schema
const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  url: `${baseUrl}/blog/author/${name}`,
  description: author.bio || undefined,
  image: author.avatar
    ? author.avatar.startsWith('http')
      ? author.avatar
      : `${baseUrl}${author.avatar}`
    : undefined,
};

// Social links for Justin Fassio
const socialLinks = author.name === 'Justin Fassio' ? [
  { name: 'YouTube', href: 'https://www.youtube.com/@aiworkoutgen', icon: 'youtube' },
  { name: 'Instagram', href: 'https://www.instagram.com/aiworkoutgenerator/', icon: 'instagram' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/justinfassio/', icon: 'linkedin' },
  { name: 'X (Twitter)', href: 'https://x.com/AI_Workout', icon: 'twitter' },
] : [];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${baseUrl}/blog/author/${name}`}
  structuredData={[breadcrumbSchema, authorSchema]}
>
  <main class="min-h-screen">
    <!-- Author Header -->
    <section class="py-16 md:py-24 bg-[var(--glass-bg-base)]">
      <div class="container-custom">
        <nav class="flex items-center gap-2 text-sm text-secondary mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
          <span>/</span>
          <span class="text-primary" aria-current="page">{author.name}</span>
        </nav>

        <div class="flex flex-col md:flex-row gap-8 items-start">
          {author.avatar && (
            <img
              src={author.avatar}
              alt={author.name}
              class="w-24 h-24 rounded-full object-cover"
              width="96"
              height="96"
            />
          )}
          <div>
            <h1 class="text-3xl md:text-4xl font-extrabold mb-4">
              Articles by {author.name}
            </h1>
            {author.bio && (
              <p class="text-lg text-secondary max-w-2xl mb-4">{author.bio}</p>
            )}
            
            {socialLinks.length > 0 && (
              <div class="flex gap-3 mb-4">
                {socialLinks.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-10 h-10 rounded-full bg-[var(--glass-bg-hover)] flex items-center justify-center hover:bg-[var(--color-accent)] hover:text-[var(--bg-dark)] transition-colors"
                    aria-label={link.name}
                  >
                    {link.icon === 'youtube' && (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                    )}
                    {link.icon === 'instagram' && (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    )}
                    {link.icon === 'linkedin' && (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    )}
                    {link.icon === 'twitter' && (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    )}
                  </a>
                ))}
              </div>
            )}
            
            <p class="text-secondary">
              {transformedPosts.length} {transformedPosts.length === 1 ? 'article' : 'articles'}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Posts Grid -->
    <section class="py-16">
      <div class="container-custom">
        {transformedPosts.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {transformedPosts.map((post) => (
              <BlogCard {...post} />
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <p class="text-secondary text-lg">No articles found.</p>
            <a href="/blog" class="text-[var(--color-accent)] font-semibold hover:underline mt-4 inline-block">
              ← Back to Blog
            </a>
          </div>
        )}
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
