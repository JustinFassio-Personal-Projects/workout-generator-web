---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/landing/Footer.astro';
import { reports } from '@/types/reports';
import { formatDate } from '@/lib/blog/formatDate';
import { buildBreadcrumbSchema } from '@/lib/breadcrumbSchema';

const baseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://aiworkoutgenerator.com';
const description =
  'In-depth research reports analyzing AI workout generators, training systems, and fitness technology trends.';

const breadcrumbSchema = buildBreadcrumbSchema(baseUrl, [
  { name: 'Home', url: baseUrl },
  { name: 'Reports', url: `${baseUrl}/reports` },
]);
---

<BaseLayout
  title="Reports | AI Workout Generator Research"
  description={description}
  canonicalUrl={`${baseUrl}/reports`}
  ogType="website"
  structuredData={breadcrumbSchema}
>
  <main class="reports-index">
    <div class="reports-index__container">
      <header class="reports-index__header">
        <h1 class="reports-index__title">Research Reports</h1>
        <p class="reports-index__subtitle">
          In-depth analysis of AI workout generators, training systems, and fitness technology
          trends.
        </p>
      </header>

      <div class="reports-index__grid">
        {reports.map((report) => (
          <a href={`/reports/${report.slug}`} class="reports-index__card">
            {report.image && (
              <div class="reports-index__image-container">
                <img
                  src={report.image}
                  alt={report.title}
                  class="reports-index__image"
                  width="400"
                  height="200"
                  loading="lazy"
                />
              </div>
            )}
            <div class="reports-index__content">
              <div class="reports-index__badge">Interactive Report</div>
              <h2 class="reports-index__card-title">{report.title}</h2>
              <p class="reports-index__excerpt">{report.excerpt}</p>
              <div class="reports-index__meta">
                <time datetime={report.date} class="reports-index__date">
                  {formatDate(report.date)}
                </time>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
    
    <Footer />
  </main>
</BaseLayout>

<style>
  .reports-index__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-md);
  }
  .reports-index__header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }
  .reports-index__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
  }
  .reports-index__subtitle {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }
  .reports-index__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--spacing-xl);
    margin-top: var(--spacing-2xl);
  }
  .reports-index__card {
    display: flex;
    flex-direction: column;
    background: var(--glass-bg-base);
    border: 1px solid var(--glass-border-base);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
  }
  .reports-index__card:hover {
    transform: translateY(-4px);
    border-color: var(--glass-border-hover);
    box-shadow: var(--shadow-lg);
  }
  .reports-index__image-container {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--bg-dark-secondary);
  }
  .reports-index__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reports-index__content {
    padding: var(--spacing-lg);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .reports-index__badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-sm);
    background: var(--color-accent);
    color: var(--bg-dark);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-sm);
    margin-bottom: var(--spacing-md);
    width: fit-content;
  }
  .reports-index__card-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--spacing-sm);
    line-height: var(--line-height-tight);
  }
  .reports-index__excerpt {
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-md);
    flex: 1;
  }
  .reports-index__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-top: auto;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--glass-border-base);
  }
  .reports-index__date {
    font-size: var(--font-size-sm);
    color: var(--text-tertiary);
  }
</style>
