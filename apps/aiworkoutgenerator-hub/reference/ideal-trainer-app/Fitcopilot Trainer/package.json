{
  "name": "gemini-personal-trainer-three",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,html,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,html,md,json}\"",
    "type-check": "tsc --noEmit",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:critical": "vitest run --grep \"critical\"",
    "test:coverage": "vitest run --coverage",
    "test:pre-deploy": "npm run type-check && npm run test:run && npm run build",
    "verify:quick": "npm run lint && npm run type-check && npm run test:run && npm run build",
    "verify": "npm run format:check && npm run verify:quick",
    "security:scan": "echo 'Security scan placeholder - integrate with snyk or npm audit' && npm audit"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@supabase/supabase-js": "2.39.7",
    "lucide-react": "^0.555.0",
    "next": "^15.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.3.1"
  }
}
